{
  "name": "session-credits",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Copilot session credits for BB, with a Pi capture extension.",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "bb-plugin",
    "copilot",
    "ai-credits",
    "pi-package"
  ],
  "scripts": {
    "test:packages": "node test/package-install-test.mjs",
    "test:plugin": "npm --prefix packages/bb-plugin-session-credits test",
    "test:collector": "node packages/bb-plugin-session-credits/collector/test/test.mjs && node packages/bb-plugin-session-credits/collector/test/regression-test.mjs && node packages/bb-plugin-session-credits/collector/test/sdk-test.mjs && node packages/bb-plugin-session-credits/collector/test/readiness-test.mjs",
    "test": "npm run test:plugin && npm run test:collector && npm run test:packages",
    "typecheck": "npm --prefix packages/bb-plugin-session-credits run typecheck",
    "build": "npm --prefix packages/bb-plugin-session-credits run build"
  },
  "author": "Lalit Rao",
  "repository": {
    "type": "git",
    "url": "https://github.com/lalitjeevanrao/copilot-session-credits.git"
  },
  "homepage": "https://github.com/lalitjeevanrao/copilot-session-credits#readme",
  "bugs": {
    "url": "https://github.com/lalitjeevanrao/copilot-session-credits/issues"
  },
  "pi": {
    "extensions": [
      "./packages/bb-plugin-session-credits/collector/extension.ts"
    ]
  }
}
